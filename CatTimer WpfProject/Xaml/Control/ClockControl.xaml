<UserControl x:Class="CatTimer_WpfProject.ClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatTimer_WpfProject"
             mc:Ignorable="d" 
             d:DesignHeight="344" d:DesignWidth="394"
             Name="ClockUserControl">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>


        <!--番茄钟：阶段的名字 + 轮次-->
        <!--（不是番茄钟模式的时候，这一整块都是隐藏的，所以原来的样子不会变）-->
        <StackPanel Name="PomodoroTextPanel" Grid.Row="0" Visibility="Collapsed"
                    HorizontalAlignment="Center" Margin="0,14,0,0">

            <!--阶段的名字-->
            <TextBlock Name="StageTextBlock"
                       Text="{Binding ElementName=ClockUserControl,Path=StageText}"
                       Foreground="#FF9C9C9C" FontSize="26" HorizontalAlignment="Center"
                       FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>

            <!--轮次-->
            <TextBlock Name="RoundTextBlock"
                       Text="{Binding ElementName=ClockUserControl,Path=RoundText}"
                       Foreground="#FFBEBEBE" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0"
                       FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>

        </StackPanel>


        <!--时钟（Clock）-->
        <Viewbox Grid.Row="1">
            <TextBlock Name="ClockTextBlock" Text="{Binding ElementName=ClockUserControl,Path=Time.TimeToHourString}"
                       Foreground="#FF656565"
                       FontFamily="{StaticResource MaybeCuteFontFamily}"/>
        </Viewbox>
    </Grid>

</UserControl>
