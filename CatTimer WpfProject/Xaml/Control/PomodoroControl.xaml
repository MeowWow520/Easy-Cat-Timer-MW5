<!--番茄钟功能-->
<UserControl x:Class="CatTimer_WpfProject.PomodoroControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CatTimer_WpfProject"
             mc:Ignorable="d" 
             d:DesignHeight="344" d:DesignWidth="394"
             Name="PomodoroUserControl">

    <Grid>

        <!--白底-->
        <Border Background="White" Opacity="1"></Border>



        <!--背景（和[设定时间]界面保持一致）-->
        <Canvas>
            <Border Background="#e2e2e2" Opacity="1"
                    Height="177" Width="139" Canvas.Left="193" Canvas.Top="82"
                    CornerRadius="10"></Border>
            <Border Background="#ffcd2f" Opacity="1"
                    Height="177" Width="139" Canvas.Left="60" Canvas.Top="64"
                    CornerRadius="10"></Border>

        </Canvas>



        <!--所有的内容-->
        <Canvas>

            <!--标题-->
            <TextBlock Text="{DynamicResource Pomodoro.Title.Text}"
                       Foreground="#FF9C9C9C" FontSize="17"
                       Width="394" Height="24" Canvas.Top="4" Canvas.Left="0"
                       TextAlignment="Center"
                       FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>


            <!--第1行：[工作]的时长-->
            <Grid Canvas.Left="30" Canvas.Top="34" Width="140" Height="40">
                <TextBlock Text="{DynamicResource Pomodoro.Stage.Work.Text}"
                           Foreground="#FF656565" FontSize="22"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
            </Grid>
            <local:ButtonControl x:Name="WorkDownButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Down.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="170" Canvas.Top="42"
                                 Cursor="Hand"
                                 Click="WorkDownButton_Click"/>
            <Grid Canvas.Left="198" Canvas.Top="34" Width="104" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingData.PomodoroWorkMinutes}"
                               Foreground="#FF656565" FontSize="26"
                               FontFamily="{StaticResource MaybeCuteFontFamily}"></TextBlock>
                    <TextBlock Text="{DynamicResource Pomodoro.Label.Minute.Text}"
                               Foreground="#FF9C9C9C" FontSize="13" Margin="4,0,0,3"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
                </StackPanel>
            </Grid>
            <local:ButtonControl x:Name="WorkUpButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Up.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="306" Canvas.Top="42"
                                 Cursor="Hand"
                                 Click="WorkUpButton_Click"/>


            <!--第2行：[短休息]的时长-->
            <Grid Canvas.Left="30" Canvas.Top="82" Width="140" Height="40">
                <TextBlock Text="{DynamicResource Pomodoro.Stage.ShortBreak.Text}"
                           Foreground="#FF656565" FontSize="22"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
            </Grid>
            <local:ButtonControl x:Name="ShortBreakDownButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Down.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="170" Canvas.Top="90"
                                 Cursor="Hand"
                                 Click="ShortBreakDownButton_Click"/>
            <Grid Canvas.Left="198" Canvas.Top="82" Width="104" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingData.PomodoroShortBreakMinutes}"
                               Foreground="#FF656565" FontSize="26"
                               FontFamily="{StaticResource MaybeCuteFontFamily}"></TextBlock>
                    <TextBlock Text="{DynamicResource Pomodoro.Label.Minute.Text}"
                               Foreground="#FF9C9C9C" FontSize="13" Margin="4,0,0,3"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
                </StackPanel>
            </Grid>
            <local:ButtonControl x:Name="ShortBreakUpButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Up.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="306" Canvas.Top="90"
                                 Cursor="Hand"
                                 Click="ShortBreakUpButton_Click"/>


            <!--第3行：[长休息]的时长-->
            <Grid Canvas.Left="30" Canvas.Top="130" Width="140" Height="40">
                <TextBlock Text="{DynamicResource Pomodoro.Stage.LongBreak.Text}"
                           Foreground="#FF656565" FontSize="22"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
            </Grid>
            <local:ButtonControl x:Name="LongBreakDownButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Down.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="170" Canvas.Top="138"
                                 Cursor="Hand"
                                 Click="LongBreakDownButton_Click"/>
            <Grid Canvas.Left="198" Canvas.Top="130" Width="104" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingData.PomodoroLongBreakMinutes}"
                               Foreground="#FF656565" FontSize="26"
                               FontFamily="{StaticResource MaybeCuteFontFamily}"></TextBlock>
                    <TextBlock Text="{DynamicResource Pomodoro.Label.Minute.Text}"
                               Foreground="#FF9C9C9C" FontSize="13" Margin="4,0,0,3"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
                </StackPanel>
            </Grid>
            <local:ButtonControl x:Name="LongBreakUpButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Up.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="306" Canvas.Top="138"
                                 Cursor="Hand"
                                 Click="LongBreakUpButton_Click"/>


            <!--第4行：[长休息]的间隔-->
            <Grid Canvas.Left="30" Canvas.Top="178" Width="140" Height="40">
                <TextBlock Text="{DynamicResource Pomodoro.Label.Rounds.Text}"
                           Foreground="#FF656565" FontSize="18"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
            </Grid>
            <local:ButtonControl x:Name="RoundsDownButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Down.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="170" Canvas.Top="186"
                                 Cursor="Hand"
                                 Click="RoundsDownButton_Click"/>
            <Grid Canvas.Left="198" Canvas.Top="178" Width="104" Height="40">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingData.PomodoroRoundsBeforeLongBreak}"
                               Foreground="#FF656565" FontSize="26"
                               FontFamily="{StaticResource MaybeCuteFontFamily}"></TextBlock>
                    <TextBlock Text="{DynamicResource Pomodoro.Label.RoundsUnit.Text}"
                               Foreground="#FF9C9C9C" FontSize="13" Margin="4,0,0,3"
                               VerticalAlignment="Bottom"
                               FontFamily="{StaticResource MaybeCuteFontFamily.IncreaseSpacing}"></TextBlock>
                </StackPanel>
            </Grid>
            <local:ButtonControl x:Name="RoundsUpButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{StaticResource UpDownButton.Up.ImageBrush}"
                                 IconWidth="18" IconHeight="18" Canvas.Left="306" Canvas.Top="186"
                                 Cursor="Hand"
                                 Click="RoundsUpButton_Click"/>


            <!--开始按钮-->
            <local:ButtonControl x:Name="StartButton"
                                 ButtonStyle="{StaticResource NoBackgroundButtonStyle}"
                                 Icon="{DynamicResource Timing.Start.ImageBrush}"
                                 IconWidth="85" IconHeight="39" Canvas.Right="48" Canvas.Top="242"
                                 Cursor="Hand"
                                 Click="StartButton_Click"/>

        </Canvas>

    </Grid>
</UserControl>
